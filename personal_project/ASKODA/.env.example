PORT=3000
NODE_ENV=production
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
SESSION_SECRET=generate-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
TRUST_PROXY=false
# SMTP server settings are required for email/password registration.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=ASKODA <no-reply@example.com>
# Optional: set this to a private persistent directory on the host.
# ASKODA_DATA_DIR=/var/lib/askoda