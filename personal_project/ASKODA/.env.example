PORT=3000
NODE_ENV=production
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
SESSION_SECRET=generate-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
TRUST_PROXY=false
# Set DATABASE_URL to the private connection URL for local PostgreSQL, if used.
# DATABASE_URL=postgresql://...
# Gmail SMTP settings are required for email/password registration.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=ASKODA <your-gmail-address@gmail.com>
# Optional: set this to a private persistent directory on the host.
# ASKODA_DATA_DIR=/var/lib/askoda